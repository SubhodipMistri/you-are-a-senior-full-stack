generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql" url = env("DATABASE_URL") }

enum UserRole { USER MODERATOR ADMIN }
enum MemberRole { OWNER CAPTAIN MANAGER PLAYER SUBSTITUTE }
enum TournamentStatus { DRAFT PUBLISHED REGISTRATION_OPEN CHECK_IN LIVE COMPLETED CANCELLED }
enum MatchStatus { PENDING LIVE COMPLETED DISPUTED }
enum TransactionType { DEPOSIT WITHDRAWAL ENTRY_FEE PRIZE REFERRAL REFUND REWARD }
enum TransactionStatus { PENDING COMPLETED FAILED REVERSED }
enum BracketFormat { SINGLE_ELIMINATION DOUBLE_ELIMINATION SWISS ROUND_ROBIN }

model User { id String @id @default(cuid()) email String @unique emailVerified DateTime? name String? image String? role UserRole @default(USER) profile Profile? wallet Wallet? accounts Account[] sessions Session[] teamMembers TeamMember[] invitesSent Invite[] notifications Notification[] achievements UserAchievement[] registrations TournamentRegistration[] createdAt DateTime @default(now()) updatedAt DateTime @updatedAt }
model Profile { id String @id @default(cuid()) userId String @unique username String @unique bio String? country String? coverUrl String? favoriteGames String[] socialLinks Json? rank Int @default(0) user User @relation(fields:[userId],references:[id],onDelete:Cascade) }
model Wallet { id String @id @default(cuid()) userId String @unique balance Decimal @default(0) currency String @default("INR") user User @relation(fields:[userId],references:[id],onDelete:Cascade) transactions Transaction[] }
model Transaction { id String @id @default(cuid()) walletId String type TransactionType amount Decimal status TransactionStatus @default(PENDING) provider String? providerRef String? metadata Json? createdAt DateTime @default(now()) wallet Wallet @relation(fields:[walletId],references:[id],onDelete:Cascade) }
model Game { id String @id @default(cuid()) slug String @unique name String @unique iconUrl String? platforms String[] tournaments Tournament[] teams Team[] }
model Team { id String @id @default(cuid()) name String @unique slug String @unique tag String @unique logoUrl String? coverUrl String? region String members TeamMember[] invites Invite[] gameId String? game Game? @relation(fields:[gameId],references:[id]) registrations TournamentRegistration[] createdAt DateTime @default(now()) }
model TeamMember { id String @id @default(cuid()) teamId String userId String role MemberRole @default(PLAYER) joinedAt DateTime @default(now()) team Team @relation(fields:[teamId],references:[id],onDelete:Cascade) user User @relation(fields:[userId],references:[id],onDelete:Cascade) @@unique([teamId,userId]) }
model Invite { id String @id @default(cuid()) teamId String email String invitedById String role MemberRole @default(PLAYER) expiresAt DateTime status String @default("PENDING") team Team @relation(fields:[teamId],references:[id],onDelete:Cascade) invitedBy User @relation(fields:[invitedById],references:[id]) }
model Tournament { id String @id @default(cuid()) slug String @unique title String gameId String bannerUrl String? description String? rules String? region String status TournamentStatus @default(DRAFT) format BracketFormat prizePool Decimal entryFee Decimal @default(0) maxTeams Int startAt DateTime game Game @relation(fields:[gameId],references:[id]) registrations TournamentRegistration[] brackets Bracket[] matches Match[] createdAt DateTime @default(now()) }
model TournamentRegistration { id String @id @default(cuid()) tournamentId String teamId String userId String? status String @default("PENDING") tournament Tournament @relation(fields:[tournamentId],references:[id],onDelete:Cascade) team Team @relation(fields:[teamId],references:[id]) user User? @relation(fields:[userId],references:[id]) @@unique([tournamentId,teamId]) }
model Bracket { id String @id @default(cuid()) tournamentId String round Int stage String matches Match[] tournament Tournament @relation(fields:[tournamentId],references:[id],onDelete:Cascade) }
model Match { id String @id @default(cuid()) tournamentId String bracketId String? round Int position Int teamOneId String? teamTwoId String? winnerId String? status MatchStatus @default(PENDING) scheduledAt DateTime? scoreOne Int @default(0) scoreTwo Int @default(0) result MatchResult? tournament Tournament @relation(fields:[tournamentId],references:[id],onDelete:Cascade) bracket Bracket? @relation(fields:[bracketId],references:[id]) }
model MatchResult { id String @id @default(cuid()) matchId String @unique proofUrl String? reportedBy String? approvedBy String? notes String? match Match @relation(fields:[matchId],references:[id],onDelete:Cascade) }
model Reward { id String @id @default(cuid()) title String description String? cost Int stock Int? imageUrl String? redemptions RewardRedemption[] }
model RewardRedemption { id String @id @default(cuid()) rewardId String userId String status String @default("PENDING") code String? createdAt DateTime @default(now()) reward Reward @relation(fields:[rewardId],references:[id]) }
model Coupon { id String @id @default(cuid()) code String @unique type String amount Decimal maxUses Int? usedCount Int @default(0) expiresAt DateTime? }
model News { id String @id @default(cuid()) slug String @unique title String excerpt String? content String authorId String category String? coverUrl String? publishedAt DateTime? comments Comment[] }
model Comment { id String @id @default(cuid()) newsId String userId String body String createdAt DateTime @default(now()) news News @relation(fields:[newsId],references:[id],onDelete:Cascade) }
model Notification { id String @id @default(cuid()) userId String type String title String body String readAt DateTime? createdAt DateTime @default(now()) user User @relation(fields:[userId],references:[id],onDelete:Cascade) }
model Achievement { id String @id @default(cuid()) code String @unique title String description String? iconUrl String? users UserAchievement[] }
model UserAchievement { id String @id @default(cuid()) userId String achievementId String unlockedAt DateTime @default(now()) user User @relation(fields:[userId],references:[id],onDelete:Cascade) achievement Achievement @relation(fields:[achievementId],references:[id]) @@unique([userId,achievementId]) }
model Account { id String @id @default(cuid()) userId String type String provider String providerAccountId String refresh_token String? access_token String? expires_at Int? token_type String? scope String? id_token String? session_state String? user User @relation(fields:[userId],references:[id],onDelete:Cascade) @@unique([provider,providerAccountId]) }
model Session { id String @id @default(cuid()) sessionToken String @unique userId String expires DateTime user User @relation(fields:[userId],references:[id],onDelete:Cascade) }
model VerificationToken { identifier String token String @unique expires DateTime @@unique([identifier,token]) }
